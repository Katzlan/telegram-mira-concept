+    /// Starts a mention: adds "@" at the end of the text and opens the keyboard, so the mention list appears.
+    @objc func mentionButtonPressed() {
+        // Typed into the field like a key press, so the mention list opens the same way as when "@" is typed.
+        // (Setting the input state directly is lost while the field is still being focused.)
+        // What the field shows right now (the interface state can lag behind a key press).
+        let rawText = self.richTextInputNode?.text ?? self.presentationInterfaceState?.interfaceState.effectiveInputState.inputText.string ?? ""
+        // Ignore invisible characters the field keeps around (zero-width spaces, attachment placeholders).
+        let invisible = CharacterSet(charactersIn: "\u{200B}\u{200C}\u{200D}\u{2060}\u{FEFF}\u{FFFC}")
+        let text = String(String.UnicodeScalarView(rawText.unicodeScalars.filter { !invisible.contains($0) }))
+        // A mention is already started and nobody picked yet: shake the field instead of adding another "@".
+        if text.hasSuffix("@") {
+            self.ensureFocused()
+            let capsule = self.textInputContainerBackgroundView
+            capsule.layer.addShakeAnimation()
+            if let inputView = self.richTextInputNode?.inputView, !inputView.isDescendant(of: capsule) {
+                inputView.layer.addShakeAnimation()
+            }
+            return
+        }
+        var insertion = "@"
+        if let last = text.last, !last.isWhitespace {
+            insertion = " @"
+        }
+        self.ensureFocused()
+        DispatchQueue.main.async { [weak self] in
+            guard let self else {
+                return
+            }
+            if let keyInput = self.richTextInputNode?.inputView as? UIKeyInput {
+                keyInput.insertText(insertion)
+            } else {
+                self.insertText(text: NSAttributedString(string: insertion))
+            }
+        }
+    }
